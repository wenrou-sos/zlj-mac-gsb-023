# 水泥排放监测平台环境变量（可按需修改后执行 ./start.sh）

# 端口
FRONTEND_PORT=8080
BACKEND_PORT=4000
POSTGRES_PORT=5432

# 数据库
POSTGRES_USER=cement
POSTGRES_PASSWORD=cement123
POSTGRES_DB=cement_emissions

# 实时数据模拟（容器部署时默认开启，便于演示）
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=5000

# 告警合并窗口（毫秒），默认 10 分钟
ALARM_MERGE_WINDOW_MS=600000
